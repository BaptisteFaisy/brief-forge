{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    // `react-jsx` : runtime JSX automatique de React 18 (plus de pragma
    // `@jsx ForgeUI.createElement` dans les .tsx). Les .tsx importent quand
    // même `React` — la config Jest du dépôt compile en runtime `classic`
    // (@swc/jest), qui a besoin de l'identifiant `React` dans la portée.
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    // `noEmit` reste à false : le bundler Forge (ts-loader) a besoin que le
    // compilateur émette. Le contrôle de type local passe par `npm run build`.
    "noEmit": false,
    "outDir": "dist",
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules"]
}
